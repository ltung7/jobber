FROM node:24-alpine AS builder

WORKDIR /app

# Install esbuild directly
RUN npm install esbuild@0.24.0

# Copy source files needed for build
COPY package.json ./
COPY scripts/build-mcp-runner.mjs ./scripts/build-mcp-runner.mjs
COPY src/mcp-runner.ts ./src/mcp-runner.ts
COPY src/lib/server/mcp/bitrix ./src/lib/server/mcp/bitrix
COPY src/lib/server/db/firebase/bitrixMcpLog.fdb.ts ./src/lib/server/db/firebase/bitrixMcpLog.fdb.ts
COPY src/lib/server/db/firebase/firebase.ts ./src/lib/server/db/firebase/firebase.ts
COPY src/lib/utils/isDev.ts ./src/lib/utils/isDev.ts

RUN npx node scripts/build-mcp-runner.mjs || node scripts/build-mcp-runner.mjs

FROM node:24-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV CLOUD_RUN_REGION=europe-west1

# Copy generated 37KB bundle and minimal package.json
COPY --from=builder /app/dist-mcp/package.json ./package.json
COPY --from=builder /app/dist-mcp/server.mjs ./server.mjs

RUN npm install --omit=dev --legacy-peer-deps

EXPOSE 8080

CMD ["node", "server.mjs"]
